root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
# Line endings are handled by .gitattributes (LF in the repo, native in the working tree).

[*.cs]
indent_size = 4

# File-scoped namespaces only (see CLAUDE.md) — `namespace Foo.Bar;`, never `namespace Foo.Bar { }`.
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error

# Always use braces around if/else/for/foreach/while/using bodies, even single-line ones (see CLAUDE.md).
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error
# The `:error` suffixes above are only honored by the IDE. The dotnet_diagnostic lines, together with
# <EnforceCodeStyleInBuild> in Directory.Build.props, are what make `dotnet build` fail on a violation.

# var only when the type is obvious from the right-hand side.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

[*.{csproj,slnx,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

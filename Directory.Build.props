<Project>

  <!-- Baseline for every project in the solution. Project files only add what is specific to them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Makes the IDE* rules configured in .editorconfig (file-scoped namespaces, braces) fail the build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
